# OFIS Admin Dashboard Environment Configuration
NODE_ENV=production
ADMIN_PORT=3001
PORT=3001

# Supabase Shared Database Configuration (Same database as main OFIS app)
SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Privileged Supabase Service Role Key (Mandatory for backend RBAC & audit logging)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Anon Key (For client-side MFA challenges)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
